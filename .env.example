# Bu dosya şablondur ve git'e gönderilir — içine gerçek değer yazma.
# Kendi değerlerini `.env.local` dosyasına kopyala; o dosya git'e gitmez.
# Vercel tarafında da Settings → Environment Variables altına aynıları girilir.

# — Supabase ————————————————————————————————————
# Panel, kurumsal siteyle AYNI Supabase projesini kullanır (ücretsiz
# planın proje sınırı yüzünden). Aşağıdaki iki değer sitenin .env
# dosyasındakiyle aynıdır.
#
# Panel tabloları `public` değil `panel` şemasında durur ve o şema
# anon rolüne kapalıdır. Supabase panelinde şemanın API'ye açılması
# gerekir: Settings → API → Exposed schemas → panel
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ service_role anahtarı bütün güvenlik kurallarını (RLS) atlar.
# Yalnızca sunucu tarafında, yalnızca gerçekten gerektiğinde kullanılır.
# NEXT_PUBLIC_ ön eki ASLA verilmez — verilirse tarayıcıya sızar.
SUPABASE_SERVICE_ROLE_KEY=

# — Telegram bildirimleri (ptp) ————————————————————
# Taşınan programda bu iki değer kodun içinde yazılıydı; buraya alındı.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# — Zamanlanmış işler ————————————————————————————
# Supabase pg_cron bu anahtarla panel uçlarını tetikler.
# Rastgele ve uzun bir değer üret.
CRON_GIZLI_ANAHTAR=
